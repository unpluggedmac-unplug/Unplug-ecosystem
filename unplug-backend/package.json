{
  "name": "unplug-backend",
  "version": "0.1.0",
  "description": "Unplug Ecosystem — Phase 3 backend starter (Step 1: Users, Auth, Roles)",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "npm run migrate && node src/app.js",
    "dev": "nodemon src/app.js",
    "migrate": "node db/migrate.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "audit": "npm audit --audit-level=moderate",
    "pretest": "node scripts/sweep-test-postgres.js && node scripts/ensure-text-search.js",
    "posttest": "node scripts/sweep-test-postgres.js",
    "backup": "node -e \"require('./src/utils/backupRunner').run().then(r=>console.log(r)).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "backup:list": "node scripts/restore-backup.js --list",
    "restore": "node scripts/restore-backup.js",
    "clone:staging": "node scripts/clone-to-staging.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "otplib": "^13.5.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "embedded-postgres": "^17.5.0-beta.15",
    "nodemon": "^3.1.0"
  }
}
