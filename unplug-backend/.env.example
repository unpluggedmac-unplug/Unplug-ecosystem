# Unplug backend environment template — never commit real secrets.
NODE_ENV=production
PORT=4000

# Required core
DATABASE_URL=
JWT_SECRET=
CORS_ORIGINS=https://www.unplugnews.com,https://unplug-magazine.pages.dev
SITE_URL=https://www.unplugnews.com
PUBLIC_API_URL=https://unplug-ecosystem.onrender.com

# Initial/recovery Super Admin seed (ADMIN_PASSWORD_RESET should normally be absent/false)
ADMIN_EMAIL=admin@unplugnews.com
ADMIN_PASSWORD=
# ADMIN_PASSWORD_RESET=false

# Email — Resend is the current preferred provider
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# RESEND_AUDIENCE_ID=
SMTP_FROM=Unplug Magazine <no-reply@unplugnews.com>
# Alternative providers only if used
# BREVO_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Cloudflare R2 public/private storage (preferred)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET=edition-downloads

# Supabase Storage fallback / legacy files
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
SUPABASE_PRIVATE_BUCKET=edition-downloads

# Scheduled/operational secrets
UNPLUG_CLEANUP_SECRET=
BIRTHDAY_CRON_SECRET=
ALTCHA_HMAC_KEY=
# ALTCHA_REQUIRED=true

# Backup configuration (recommended before production changes)
UNPLUG_BACKUP_PASSPHRASE=
# UNPLUG_BACKUP_KEEP=14
# B2_BUCKET=
# B2_ENDPOINT=
# B2_ACCESS_KEY_ID=
# B2_SECRET_ACCESS_KEY=
# B2_REGION=

# Staging only — never point this at DATABASE_URL
# STAGING_DATABASE_URL=

# Online gateways remain intentionally disabled for initiation in Phase 11.
# Callback verification fails closed if these are absent.
# PAYFAST_PASSPHRASE=
# OZOW_PRIVATE_KEY=

# Operational addresses
# SALES_EMAIL=sales@unplugnews.com
# UNPLUG_SECURITY_ALERT_EMAIL=

# Do not enable in production
# UNPLUG_DISABLE_RATE_LIMITS=false
