# STAGING ONLY — never put real secrets in this file.
UNPLUG_ENV=staging
NODE_ENV=production
PORT=4000

# Safety guard: in staging these two values must be identical.
DATABASE_URL=
STAGING_DATABASE_URL=
JWT_SECRET=

# Use the actual preview/staging origins after they exist.
CORS_ORIGINS=https://YOUR-STAGING-PAGES.pages.dev
SITE_URL=https://YOUR-STAGING-PAGES.pages.dev
PUBLIC_API_URL=https://YOUR-STAGING-API.onrender.com

# Seed a TEST Super Admin only.
ADMIN_EMAIL=staging-admin@example.com
ADMIN_PASSWORD=
# ADMIN_PASSWORD_RESET=false

# Prefer a Resend test-safe setup / staging sender.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SMTP_FROM=Unplug Staging <no-reply@YOUR-VERIFIED-DOMAIN.example>

# Staging storage should use a separate bucket/prefix/project where possible.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET=edition-downloads-staging

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
SUPABASE_PRIVATE_BUCKET=edition-downloads-staging

UNPLUG_CLEANUP_SECRET=
BIRTHDAY_CRON_SECRET=
ALTCHA_HMAC_KEY=
UNPLUG_BACKUP_PASSPHRASE=

# Keep online gateway initiation disabled for staging until implemented.
# PAYFAST_PASSPHRASE=
# OZOW_PRIVATE_KEY=
# UNPLUG_DISABLE_RATE_LIMITS=false
# ADMIN_PASSWORD_RESET=false
